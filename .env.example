# Copier ce fichier en .env et remplir les valeurs (ne jamais committer .env)
# Supabase > bouton "Connect" > "Session pooler" (fonctionne en IPv4, ex. réseau de l'école)
DATABASE_URL=postgresql://postgres.XXXXXXXX:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > API
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_ANON_KEY=coller_la_cle_anon_ici
